# Required before production deployment. Never use a placeholder domain in production.
NEXT_PUBLIC_SITE_URL=https://www.seu-dominio-real.com.br
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# Admin auth (email + session secret + one of the two password hash forms
# below are all required to enable /admin login). Generate a hash with:
#   node scripts/create-admin-hash.mjs "<sua senha>"
ADMIN_EMAIL=
# WARNING: do NOT put the raw "scrypt$salt$hash" value in this or any other
# .env* file — Next.js's env loader expands "$word" sequences in files it
# reads, silently truncating the hash to the literal string "scrypt" and
# making every login fail with no useful error. Use ADMIN_PASSWORD_HASH_BASE64
# instead in files like this one; reserve this raw form for a real process
# environment variable (shell export, Docker Compose `environment:`, a
# secret manager) which Next never re-parses.
ADMIN_PASSWORD_HASH=
# Safe to put in .env.local: base64 of the "scrypt$salt$hash" string above
# (the create-admin-hash.mjs script prints both forms).
ADMIN_PASSWORD_HASH_BASE64=
ADMIN_SESSION_SECRET=

# Optional: restrict which hosts admin-entered affiliate/search links may point to
AFFILIATE_ALLOWED_HOSTS=mercadolivre.com.br,lista.mercadolivre.com.br,meli.la

# Optional: override where the SQLite file and its backups live
DATABASE_PATH=
BACKUP_PATH=
BACKUP_MAX_COUNT=
BACKUP_MAX_BYTES=
